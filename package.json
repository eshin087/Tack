{
  "name": "tack",
  "version": "0.1.0",
  "description": "Pin a site: filter to every search — Tack auto-appends modifiers (e.g. site:reddit.com) on Google, Bing, DuckDuckGo, Yahoo, Ecosia, and Brave.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6"
  }
}
