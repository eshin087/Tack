{
  "manifest_version": 3,
  "name": "Tack",
  "version": "0.1.0",
  "description": "Pin a site: filter to every search. One key cycles between Reddit, GitHub, Stack Overflow & more on Google, Bing & DuckDuckGo.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "*://www.google.com/*",
    "*://www.bing.com/*",
    "*://duckduckgo.com/*",
    "*://search.yahoo.com/*",
    "*://www.ecosia.org/*",
    "*://search.brave.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tack settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.bing.com/search*",
        "*://duckduckgo.com/*",
        "*://search.yahoo.com/search*",
        "*://www.ecosia.org/search*",
        "*://search.brave.com/search*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-filter": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Toggle Tack filter for the current results page"
    },
    "enable-filter": {
      "description": "Apply filter — enable Tack for the current results page"
    },
    "disable-filter": {
      "description": "Show all — disable Tack for the current results page"
    },
    "show-ui": {
      "description": "Show / hide the Tack bar (used in Silent mode)"
    },
    "cycle-profile": {
      "description": "Cycle to the next filter profile"
    },
    "cycle-profile-back": {
      "description": "Cycle to the previous filter profile"
    }
  }
}
